# Postgres (Neon, dal marketplace di Vercel)
DATABASE_URL=postgres://...
# Stringa casuale lunga almeno 32 caratteri (es. openssl rand -base64 32)
SESSION_SECRET=
# Da https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# URL pubblico del sito, senza slash finale (es. https://cuginidicerignolacampagna.vercel.app)
APP_URL=http://localhost:3000
# Stringa casuale: Vercel la usa per autenticare l'aggiornamento notturno
CRON_SECRET=
